{% import "macros.njk" as m with context %}

<section class="hero" aria-labelledby="productos-title">
  <div class="ds-container hero__grid">
    <div class="hero__copy">
      <nav aria-label="Ruta de navegación">
        <ol class="ds-breadcrumb"><li><a href="/">Inicio</a></li><li aria-current="page">Productos</li></ol>
      </nav>
      <h1 class="site-display" id="productos-title">Una línea de productos completa para negocios de alta performance</h1>
      <p class="hero__lead">iPlace Corporativo, canal especializado en venta de productos Apple para empresas, posee en su portafolio las mejores soluciones para que los profesionales trabajen de forma intuitiva, segura y productiva, ampliando la creatividad y colaboración en cualquier segmento de mercado.</p>
    </div>
    <div class="hero__media hero__media--contain">
      <img src="/assets/img/hero/productos.webp" alt="Apple TV, MacBook Pro, iPad Pro, iPhone, AirPods Pro y Apple Watch" width="859" height="500" fetchpriority="high">
    </div>
  </div>
</section>

<section class="section" aria-labelledby="lineas-title">
  <div class="ds-container">
    <div class="section__head">
      <h2 class="site-title" id="lineas-title">Conozca nuestros productos y plataformas</h2>
    </div>
    <div>
      {%- for line in lines %}
      <article class="product-row" id="{{ line.name | slugify }}">
        <div class="product-row__media">
          <img src="{{ line.image }}" alt="{{ line.alt }}" width="{{ line.w }}" height="{{ line.h }}" loading="lazy">
        </div>
        <div class="product-row__copy">
          <h3 class="site-title">{{ line.name }}</h3>
          <p class="text">{{ line.text }}</p>
          <div class="ds-cluster">
            <a class="ds-btn ds-btn--primary" href="{{ line.url }}">{{ line.cta }}</a>
            {%- if line.extra %}<a class="ds-btn ds-btn--outline" href="{{ line.extra.url }}">{{ line.extra.label }}</a>{% endif %}
          </div>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--sunken" aria-labelledby="contacto-title">
  <div class="ds-container">
    <div class="section__head">
      <h2 class="site-title" id="contacto-title">Contacto</h2>
    </div>
    <div class="band-stack">
      {{ m.people(['diego', 'marcos']) }}
      {{ m.social() }}
    </div>
  </div>
</section>
