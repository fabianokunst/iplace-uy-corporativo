{% import "macros.njk" as m with context %}

{{ m.pageHero('Originales iPlace', 'Originales iPlace Corporativo', 'La personalidad no es un diferencial, es esencial.', 'La personalidad de tu empresa estampada con los Originales iPlace. Productos Premium, con acabados impecables y tecnología de vanguardia para tu día a día. Diseño, tecnología y calidad iPlace Corporativo.', '/assets/img/hero/originales.webp', 'Personas con mochilas, bolsos y fundas Originales iPlace', {label: 'Productos', url: '/productos/'}) }}

<section class="section section--sunken" aria-labelledby="lineas-title">
  <div class="ds-container">
    <div class="section__head">
      <img src="/assets/img/originales/marca.webp" alt="Originales iPlace" width="150" height="100" class="brand-mark">
      <h2 class="site-title" id="lineas-title">Inspirado para vos.</h2>
      <nav aria-label="Líneas Originales iPlace">
        <ul class="line-nav">
          {%- for line in lines %}
          <li><a href="#linea{{ line.id }}"><img src="/assets/img/originales/logo-{{ line.id }}.webp" alt="{{ line.name }}" width="{{ line.logo[0] }}" height="{{ line.logo[1] }}" loading="lazy"></a></li>
          {%- endfor %}
          <li><a href="#lineaoriginales"><img src="/assets/img/originales/marca-accesorios.webp" alt="Accesorios Originales iPlace" width="300" height="240" loading="lazy"></a></li>
        </ul>
      </nav>
    </div>
    <div class="lines">
      {%- for line in lines %}
      <article class="line" id="linea{{ line.id }}">
        <img class="line__photo" src="/assets/img/originales/{{ line.id }}.webp" alt="Productos de la {{ line.name }}" width="630" height="450" loading="lazy">
        <div class="line__body">
          <h3><img class="line__logo" src="/assets/img/originales/logo-{{ line.id }}.webp" alt="{{ line.name }}" width="{{ line.logo[0] }}" height="{{ line.logo[1] }}" loading="lazy"></h3>
          <p>{{ line.text }}</p>
          <a class="ds-btn ds-btn--outline ds-btn--small" href="/contacto/" aria-label="Saber más sobre la {{ line.name }}">Saber más</a>
        </div>
      </article>
      {%- endfor %}
      <article class="line" id="lineaoriginales">
        <img class="line__photo" src="/assets/img/originales/accesorios.webp" alt="Accesorios Originales iPlace" width="630" height="450" loading="lazy">
        <div class="line__body">
          <h3 class="ds-h4">Accesorios Originales iPlace</h3>
          <p>Consultá la línea completa de Accesorios Originales.</p>
          <a class="ds-btn ds-btn--outline ds-btn--small" href="/contacto/" aria-label="Saber más sobre los Accesorios Originales iPlace">Saber más</a>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="registro-title">
  <div class="ds-container">
    <div class="section__head">
      <h2 class="site-title" id="registro-title">¡Registrá tu empresa aquí!</h2>
