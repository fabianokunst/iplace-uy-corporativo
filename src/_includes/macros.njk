{#- Blocos reutilizados pelas páginas. Importe com: {% import "macros.njk" as m with context %} -#}

{#- Migalhas do topo das páginas internas. -#}
{% macro breadcrumb(crumb, parent) %}
<nav aria-label="Ruta de navegación">
  <ol class="ds-breadcrumb">
    <li><a href="/">Inicio</a></li>
    {%- if parent %}<li><a href="{{ parent.url }}">{{ parent.label }}</a></li>{% endif %}
    <li aria-current="page">{{ crumb }}</li>
  </ol>
</nav>
{% endmacro %}

{#- Topo das páginas internas: migalhas, título com o texto de apoio ao lado, ações (caller) e foto larga. -#}
{% macro pageHero(crumb, eyebrow, title, lead, image, imageAlt, parent) %}
<section class="page-hero">
  <div class="ds-container page-hero__inner">
    {{ breadcrumb(crumb, parent) }}
    <div class="page-hero__row">
      <div class="page-hero__copy">
        {%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
        <h1 class="site-display">{{ title | safe }}</h1>
      </div>
      {%- if lead %}<p class="lead">{{ lead | safe }}</p>{% endif %}
    </div>
    {%- if caller %}<div class="page-hero__actions">{{ caller() }}</div>{% endif %}
    {%- if image %}
    <div class="page-hero__media">
      <img src="{{ image }}" alt="{{ imageAlt }}" width="1920" height="270" fetchpriority="high">
    </div>
    {%- endif %}
  </div>
</section>
{% endmacro %}

{#- Cartões dos especialistas comerciais (dados em _data/site.json). -#}
{% macro people(ids) %}
<div class="people">
  {%- for id in ids %}
  {%- set p = site.people | find('id', id) %}
  <div class="person">
    <div class="person__avatar">
      {%- if p.photo %}<img src="{{ p.photo }}" alt="" width="72" height="72" loading="lazy">{% else %}<span aria-hidden="true">{{ p.initials }}</span>{% endif %}
    </div>
    <div class="person__body">
      <p class="person__name">{{ p.name }}</p>
      <p class="person__role">Especialista iPlace Corporativo</p>
    </div>
    <div class="person__links">
      <a class="ds-btn ds-btn--primary ds-btn--small" href="{{ p.whatsapp | whatsapp(site.whatsappText) }}" target="_blank" rel="noopener" aria-label="WhatsApp de {{ p.name }}: {{ p.phone }}"><svg class="ds-icon ds-icon--small" aria-hidden="true"><use href="#i-sms"/></svg>{{ p.phone }}</a>
      <a class="ds-btn ds-btn--outline ds-btn--small" href="mailto:{{ p.email }}" aria-label="Enviar un correo a {{ p.name }}"><svg class="ds-icon ds-icon--small" aria-hidden="true"><use href="#i-email"/></svg>Enviar un correo</a>
    </div>
  </div>
  {%- endfor %}
</div>
{% endmacro %}

{% macro social() %}
<ul class="social" aria-label="Redes sociales">
  {%- for s in site.social %}
  <li><a href="{{ s.url }}" target="_blank" rel="noopener"><svg class="ds-icon ds-icon--small" aria-hidden="true"><use href="#i-{{ s.label | lower }}"/></svg>{{ s.label }}</a></li>
  {%- endfor %}
</ul>
{% endmacro %}

{#- Campos ocultos dos formulários do Emarsys (link.iplace.com.uy), como no HTML gerado lá: conta (CID),
    formulário (f), página e ação de cadastro (p, a) e "Formulário iPlace Corp UY" (inp_17832) sempre SIM.
    optin=true manda o opt-in sempre, para forms em que o aceite obrigatório já é o pedido de emails.
    O integrations.js troca os outros campos pelos inp_* do Emarsys e envia. -#}
{% macro emarsysFields(formId, optin=false) %}
<input type="hidden" name="CID" value="1095776552">
<input type="hidden" name="f" value="{{ formId }}">
<input type="hidden" name="p" value="2">
<input type="hidden" name="a" value="r">
<input type="hidden" name="inp_17832" value="SIM">
{%- if optin %}
<input type="hidden" name="optin" value="y">
{%- endif %}
{% endmacro %}

{#- Formulário de lead. O envio é feito por integrations/integrations.js (data-lead-form);
    o consent.js insere o aceite da política antes do botão. Com emarsysForm (ID do formulário no Emarsys), vai para lá.
    Campos: first_name, last_name, email, company_name, mobile_phone, message (o integrations.js junta o nome completo em name).
    Os maxlength são os limites dos campos no Emarsys. -#}
{% macro leadForm(id, submitLabel, withMessage=true, compact=false, emarsysForm) %}
<form class="lead-form{% if compact %} lead-form--single{% endif %}" data-lead-form="{{ id }}" method="post" action="#">
  {%- if emarsysForm %}{{ emarsysFields(emarsysForm) }}{% endif %}
  <div class="ds-field">
    <label class="ds-field__label" for="{{ id }}-first-name">Nombre</label>
    <input class="ds-input" id="{{ id }}-first-name" name="first_name" type="text" autocomplete="given-name" maxlength="60" required>
  </div>
  <div class="ds-field">
    <label class="ds-field__label" for="{{ id }}-last-name">Apellido{% if compact %} <span class="optional">(opcional)</span>{% endif %}</label>
    <input class="ds-input" id="{{ id }}-last-name" name="last_name" type="text" autocomplete="family-name" maxlength="60"{% if not compact %} required{% endif %}>
  </div>
  <div class="ds-field">
    <label class="ds-field__label" for="{{ id }}-email">E-mail</label>
    <input class="ds-input" id="{{ id }}-email" name="email" type="email" autocomplete="email" maxlength="255" required>
  </div>
  {%- if not compact %}
  <div class="ds-field">
    <label class="ds-field__label" for="{{ id }}-phone">Teléfono</label>
    <input class="ds-input" id="{{ id }}-phone" name="mobile_phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="60" required>
  </div>
  {%- endif %}
  <div class="ds-field{% if not compact %} ds-field--full{% endif %}">
    <label class="ds-field__label" for="{{ id }}-company">Empresa{% if compact %} <span class="optional">(opcional)</span>{% endif %}</label>
    <input class="ds-input" id="{{ id }}-company" name="company_name" type="text" autocomplete="organization" maxlength="255"{% if not compact %} required{% endif %}>
  </div>
  {%- if withMessage %}
  <div class="ds-field ds-field--full">
    <label class="ds-field__label" for="{{ id }}-message">Mensaje <span class="optional">(opcional)</span></label>
    <textarea class="ds-textarea" id="{{ id }}-message" name="message" rows="4" maxlength="255" placeholder="Contanos qué necesita tu empresa: productos, cantidades, plazos."></textarea>
  </div>
  {%- endif %}
  <div class="lead-form__actions">
    <button class="ds-btn ds-btn--primary" type="submit">{{ submitLabel }}</button>
  </div>
  <p data-lead-status aria-live="polite"></p>
</form>
{% endmacro %}
