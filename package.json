{
  "name": "iplace-corporativo-uy",
  "private": true,
  "description": "Sitio institucional estático de iPlace Corporativo Uruguay (iplacecorp.com.uy).",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
    "build": "npm run clean && eleventy",
    "start": "npm run clean && eleventy --serve --port=5590",
    "images": "python scripts/images.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2"
  }
}
